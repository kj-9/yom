{
  "name": "@kj-9/yom",
  "version": "0.1.0-alpha.6",
  "description": "Markdown tree viewer and static site builder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kj-9/yom.git"
  },
  "homepage": "https://github.com/kj-9/yom#readme",
  "bugs": {
    "url": "https://github.com/kj-9/yom/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "bin",
    "index.html",
    "lib",
    "src/site",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "bin": {
    "yom": "bin/yom"
  },
  "exports": {
    ".": "./lib/core/config.js"
  },
  "scripts": {
    "compile": "node ./scripts/compile.mjs",
    "dev": "bun run ./src/cli/index.ts dev",
    "build": "bun run check && bun run compile && node ./lib/cli/index.js build",
    "benchmark": "bun run ./scripts/benchmark.ts",
    "check:assets": "bun run ./scripts/check-assets.ts",
    "preview": "bun run ./src/cli/index.ts preview",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:package": "vitest run tests/package",
    "check": "tsc --noEmit",
    "publish-alpha": "bun run release",
    "prepack": "bun run check && bun run compile",
    "prepublishOnly": "bun run check && bun run test",
    "release": "bun run ./scripts/release.ts",
    "format": "prettier --check \"bin\" \"index.html\" \"playwright.config.ts\" \"scripts/**/*.ts\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tabler/icons-preact": "3.46.0",
    "cac": "^6.7.14",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.12.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "vite": "^7.1.3"
  }
}
