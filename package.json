{
  "name": "@kj-9/yom",
  "version": "0.1.0-alpha.3",
  "description": "Markdown tree viewer and static site builder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kj-9/yom.git"
  },
  "homepage": "https://github.com/kj-9/yom#readme",
  "bugs": {
    "url": "https://github.com/kj-9/yom/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "bin",
    "index.html",
    "src",
    "vite.config.ts",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "bin": {
    "yom": "bin/yom"
  },
  "exports": {
    ".": "./src/core/config.ts"
  },
  "scripts": {
    "dev": "bun run ./src/cli/index.ts dev",
    "build": "tsc --noEmit && bun run ./src/cli/index.ts build",
    "benchmark": "bun run ./scripts/benchmark.ts",
    "preview": "bun run ./src/cli/index.ts preview",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:package": "vitest run tests/package",
    "check": "tsc --noEmit",
    "publish-alpha": "bun run release",
    "prepublishOnly": "bun run check && bun run test",
    "release": "bun run ./scripts/release.ts",
    "format": "prettier --check \"bin\" \"index.html\" \"playwright.config.ts\" \"scripts/**/*.ts\" \"src/**/*.{ts,css}\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.12.0",
    "vite": "^7.1.3"
  }
}
